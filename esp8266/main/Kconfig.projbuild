menu "ESPKeyboard ESP-NOW link"

config ESPNOW_CHANNEL
    int "ESP-NOW channel"
    range 1 13
    default 1

config ESPNOW_PEER_MAC
    string "Paired ESP32-S3 station MAC address"
    default "00:00:00:00:00:00"
    help
        Set this to the station MAC printed by the ESP32-S3 transmitter.

endmenu
